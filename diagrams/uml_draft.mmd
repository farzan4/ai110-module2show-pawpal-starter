classDiagram
    direction LR

    class Owner {
        +str owner_id
        +str name
        +int daily_available_mins
        +List[Pet] pets
        +Dict preferences
        +add_pet(pet)
        +get_all_tasks()
    }

    class Pet {
        +str pet_id
        +str name
        +str species
        +float age
        +List[str] special_needs
        +List[Task] tasks
        +add_task(task)
        +remove_task(task_id)
        +get_pending_tasks()
    }

    class Task {
        +str task_id
        +str title
        +str category
        +int duration_mins
        +int priority
        +time preferred_time
        +bool is_flexible
        +bool is_completed
        +mark_complete()
        +update_details()
    }

    class TimeSlot {
        +Task task
        +time start_time
        +time end_time
        +overlaps_with(other)
        +get_duration_minutes()
    }

    class Scheduler {
        +generate_schedule(tasks, available_mins)
        +_resolve_conflicts(slots)
    }

    class DailyPlan {
        +date plan_date
        +List[TimeSlot] scheduled_slots
        +List[Task] omitted_tasks
        +List[str] reasoning_log
        +get_total_scheduled_minutes()
        +get_plan_summary()
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" --> "*" Task : has
    Scheduler ..> Task : processes
    Scheduler ..> TimeSlot : creates
    DailyPlan "1" o-- "*" TimeSlot : contains
    DailyPlan "1" o-- "*" Task : omits